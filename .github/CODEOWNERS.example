# Copy this file to .github/CODEOWNERS after replacing placeholders with real GitHub usernames or teams.
# Do not enable this file until every placeholder is replaced.

# Backend developer — مطور Backend
/server/ @your-backend-owner

# Frontend developer — مطور Frontend
/web/ @your-frontend-owner

# Data/AI engineer — مهندس AI وData
/server/src/ai.js @your-ai-data-owner
/server/src/tools.js @your-ai-data-owner
/server/evals/ @your-ai-data-owner
/data/ @your-ai-data-owner
/.tmp-knowledge/ @your-ai-data-owner

# DevOps and QA engineer — مهندس QA وDevOps
/Dockerfile @your-devops-qa-owner
/railway.json @your-devops-qa-owner
/render.yaml @your-devops-qa-owner
/package.json @your-devops-qa-owner
/pnpm-workspace.yaml @your-devops-qa-owner
/.env.example @your-devops-qa-owner

# Documentation is shared unless your team wants stricter ownership.
/docs/ @your-devops-qa-owner
/team/ @your-devops-qa-owner
