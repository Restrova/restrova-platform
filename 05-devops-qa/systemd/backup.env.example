# Configuration template only. Never commit actual keys or AWS credentials.
# The host must have Node, server dependencies and official AWS CLI v2 installed.
# Use a host IAM role with a private dedicated S3 bucket. Do not configure a
# custom endpoint or disable TLS verification. An IAM role avoids static keys.
DATABASE_PATH=/var/data/restrova/restaurant.db
RESTROVA_BACKUP_WORK_DIR=/var/lib/restrova-backup
RESTROVA_BACKUP_S3_BUCKET=replace-with-private-backup-bucket
RESTROVA_BACKUP_S3_PREFIX=production
AWS_REGION=me-south-1
RESTROVA_BACKUP_KEY_VERSION=replace-with-key-version
# RESTROVA_BACKUP_KEY must be injected from the operator's secret manager:
# exactly 64 hexadecimal characters (32 random bytes), separate from JWT_SECRET.
