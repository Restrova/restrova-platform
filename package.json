{
  "name": "restrova-platform",
  "private": true,
  "version": "1.0.0",
  "description": "Restrova Platform monorepo for AI-assisted restaurant operations.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Restrova/restrova-platform.git"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "workspaces": [
    "02-backend/server",
    "03-frontend/web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"pnpm --filter server dev\" \"pnpm --filter web dev\"",
    "start": "pnpm --filter server start",
    "lint": "pnpm --filter web lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "pnpm --filter web test",
    "test:integration": "pnpm --filter server test",
    "build": "pnpm --filter web build",
    "validate": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "security:audit": "pnpm audit --audit-level low",
    "security:test": "node --test scripts/security/*.test.mjs",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "concurrently": "^9.2.3",
    "prettier": "^3.9.6"
  }
}
