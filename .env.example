PORT=4000
# Production must use a strong random value of at least 32 characters.
JWT_SECRET=replace-this-in-production
DATABASE_PATH=./data/restaurant.db
CLIENT_ORIGIN=http://localhost:5173
REQUEST_BODY_LIMIT=3mb
JWT_EXPIRES_IN=12h
JWT_ISSUER=ai-restaurant-manager
JWT_AUDIENCE=restaurant-manager-api
BCRYPT_COST=12
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=900000

# Explicit opt-in for the seeded demo restaurant (owner@harbor.test / demo1234).
# Never enable in production. The backend test suite and evals set this themselves.
ENABLE_DEMO_SEED=

# Simple database backup policy (see docs/operations/backup-restore.md).
# BACKUP_ENABLED=true starts a daily in-process backup scheduler; the CLI
# scripts/backup-db.js + scripts/restore-db.js work with or without it.
BACKUP_ENABLED=
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=7
# BACKUP_DIR=  (default: <database directory>/backups)

# Safe staged-import limits. Values are enforced by the backend.
IMPORT_MAX_FILE_SIZE_BYTES=5000000
IMPORT_MAX_ROWS=10000
IMPORT_MAX_COLUMNS=100
IMPORT_MAX_CELL_LENGTH=10000
IMPORT_PREVIEW_ROWS=20
IMPORT_CONFIRMATION_TOKEN_TTL_SECONDS=1800
IMPORT_PREVIEW_RATE_LIMIT_MAX=20
IMPORT_ACTION_RATE_LIMIT_MAX=60

# Optional: enable backend-only OpenAI Responses API mode.
# Leave OPENAI_API_KEY empty to use the deterministic built-in assistant.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_REASONING_EFFORT=
OPENAI_TEXT_VERBOSITY=
OPENAI_MAX_OUTPUT_TOKENS=1600
