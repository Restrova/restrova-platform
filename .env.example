PORT=4000
# Production must use a strong random value of at least 32 characters.
JWT_SECRET=replace-this-in-production
DATABASE_PATH=./data/restaurant.db
CLIENT_ORIGIN=http://localhost:5173
REQUEST_BODY_LIMIT=3mb
JWT_EXPIRES_IN=12h
JWT_ISSUER=ai-restaurant-manager
JWT_AUDIENCE=restaurant-manager-api
BCRYPT_COST=12
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=900000

# Optional: enable backend-only OpenAI Responses API mode.
# Leave OPENAI_API_KEY empty to use the deterministic built-in assistant.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_REASONING_EFFORT=
OPENAI_TEXT_VERBOSITY=
OPENAI_MAX_OUTPUT_TOKENS=1600
